  - REASONING: <1-2 sentences to explain why the score is assigned to this item>
  {% endfor %}
  PROGRESS: <Yes/No + short reason>
  REASONING: <2-3 sentences>
  SCORE: <scalar 0.0-1.0>
{% endfor %}
REASONING: <2-5 sentences>
FINAL: <best candidate number>

